# ── PRODUÇÃO — Logos IA · Gerador de Arte ──
# Copie este arquivo como referência ao configurar as variáveis no EasyPanel.

# Ambiente
NODE_ENV=production
PORT=4000

# Banco — Supabase Postgres (Connection Pooling)
# Pegue em: Supabase → Project Settings → Database → Connection string → Transaction
# Substitua [YOUR-PASSWORD] e [PROJECT-REF] pelos seus valores.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# URL pública (com https://) — usada para CORS
PUBLIC_URL=https://arte.logosia.com.br

# Segredo de sessão — gere com `openssl rand -hex 32`
SESSION_SECRET=troque-este-segredo-para-algo-bem-aleatorio

# Storage — local (uploads salvos em /app/data/uploads, monte como volume)
STORAGE_DRIVER=local
UPLOAD_DIR=/app/data/uploads
PUBLIC_UPLOAD_BASE=/uploads

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI alternativa
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# OAuth Manus (placeholder — ainda não usado)
MANUS_OAUTH_CLIENT_ID=
MANUS_OAUTH_CLIENT_SECRET=
MANUS_OAUTH_REDIRECT=
