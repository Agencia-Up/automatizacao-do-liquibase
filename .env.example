# Server
PORT=4000
NODE_ENV=development

# Database (SQLite local)
DATABASE_URL=./data/sala.db

# Sessao
SESSION_SECRET=troque-este-segredo-para-algo-bem-aleatorio

# Storage (uploads locais por padrao; troque para s3 em prod)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
PUBLIC_UPLOAD_BASE=/uploads

# LLM (opcional). Se nao definido, usa fallback determinístico.
# Suporta provedor: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OAuth Manus (placeholder; usa login simples se vazio)
MANUS_OAUTH_CLIENT_ID=
MANUS_OAUTH_CLIENT_SECRET=
MANUS_OAUTH_REDIRECT=
